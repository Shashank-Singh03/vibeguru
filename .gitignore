# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
vibeguru-*.tar

# Temporary files, for example, from tests.
/tmp/

# --- Node / browser-driver (driver-node, test-app) ---
node_modules/
npm-debug.log*
playwright-report/
.playwright/

# Vite build output
/test-app/dist/

# Built escript binary
/vibeguru

# Burrito release output (self-contained binaries) and the npm wrapper's
# downloaded copy of the platform binary.
/burrito_out/
/vendor/

# Generated report output (CLAUDE.md, vibeguru-report.md, vibeguru-findings.json).
# This is the default --out directory, and CI writes here too, so anyone following
# the README's build-from-source steps produces one.
/reports/

# Generated run output from local verification (tmp_out, tmp_low, any scratch dir)
/tmp_*/

# Captured browser session from `vibeguru auth`. The directory already ships its own
# .gitignore containing "*", so this is belt and braces: auth.json is the equivalent
# of being signed in as that user, and a single missing self-ignore would commit a
# live session to a public repo.
.vibeguru/

# Generated run artifacts in the bundled test app (vibeguru.json is kept as a sample)
/test-app/CLAUDE.md
/test-app/vibeguru-report.md
/test-app/vibeguru-findings.json
handover.md