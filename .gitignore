# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
vibeguru-*.tar

# Temporary files, for example, from tests.
/tmp/

# --- Node / browser-driver (driver-node, test-app) ---
node_modules/
npm-debug.log*
playwright-report/
.playwright/

# Vite build output
/test-app/dist/

# Built escript binary
/vibeguru

# Generated report output (CLAUDE.md, vibeguru-report.md, vibeguru-findings.json)
/tmp_out/
/tmp_out_*/

# Generated run artifacts in the bundled test app (vibeguru.json is kept as a sample)
/test-app/CLAUDE.md
/test-app/vibeguru-report.md
/test-app/vibeguru-findings.json
