{
  "name": "vibeguru",
  "version": "1.0.0",
  "description": "Scoped runtime and repeated-use checks for React applications, with retained evidence and CLI/MCP verdicts.",
  "bin": {
    "vibeguru": "bin/vibeguru.js"
  },
  "type": "commonjs",
  "files": [
    "bin/",
    "scripts/postinstall.js",
    "scripts/release-check.mjs",
    "scripts/lib/doctor.js",
    "scripts/lib/download.js",
    "scripts/lib/launch.js",
    "scripts/lib/platform.js",
    "scripts/lib/setup.js",
    "scripts/lib/telemetry.js",
    "scripts/lib/telemetry-cli.js",
    "mcp/",
    "driver-node/index.js",
    "driver-node/lib/",
    "driver-node/package.json",
    "docs/GETTING_STARTED.md",
    "docs/TELEMETRY.md"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "test": "node scripts/test-node.mjs",
    "check": "node scripts/checks.mjs",
    "test:elixir": "node scripts/checks.mjs elixir",
    "dashboard": "node --watch scripts/dashboard.mjs",
    "lab:adversarial": "node scripts/adversarial-lab.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "release:check": "node scripts/release-check.mjs",
    "prepublishOnly": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright": "1.63.0",
    "zod": "^4.6.1"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "memory-leak",
    "performance",
    "react",
    "vue",
    "spa",
    "vibe-coding",
    "ai",
    "claude",
    "mcp",
    "model-context-protocol",
    "agent",
    "runtime-verification"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Shashank-Singh03/vibeguru#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shashank-Singh03/vibeguru.git"
  },
  "bugs": {
    "url": "https://github.com/Shashank-Singh03/vibeguru/issues"
  }
}
